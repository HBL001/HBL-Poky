+/* SPDX-License-Identifier: GPL-2.0+ */
+#ifndef _UAPI_LINUX_FT800_H
+#define _UAPI_LINUX_FT800_H
+
+/* -------------------------------------------------------------------- */
+/*  Public types                                                        */
+/* -------------------------------------------------------------------- */
+#ifdef __KERNEL__
+# include <linux/types.h>
+# include <linux/ioctl.h>
+#else
+# include <stdint.h>
+# include <sys/ioctl.h>
+typedef uint8_t   __u8;
+typedef uint16_t  __u16;
+typedef uint32_t  __u32;
+typedef uint64_t  __u64;
+typedef  int16_t  __s16;
+typedef __u16     __le16;
+#endif
+
+#ifndef __packed                     /* keep user-space self-contained */
+# define __packed __attribute__((packed))
+#endif
+
+/* -------------------------------------------------------------------- */
+/*  Shared constants                                                    */
+/* -------------------------------------------------------------------- */
+#define FT800_MAX_CMD_TEXT_LEN   63U      /* text[] = 64 incl. NUL */
+
+/* -------------------------------------------------------------------- */
+/*  UAPI structures – must precede the _IO* macros that use sizeof()    */
+/* -------------------------------------------------------------------- */
+
+/* Touch sample returned by FT800_IOCTL_GET_TOUCH */
+struct ft800_touch {
+	__le16 x;
+	__le16 y;
+	__u8   tag;
+	__u8   pad;
+} __packed;
+
+/* Generic “co-processor command” slot */
+struct ft800_cmd {
+    __u32 cmd;
+    __u16 x, y;
+    __u16 w, h;
+    __u8  font;
+    __u8  options;
+    __u16 val;
+    __u16 range;
+    __u32 arg;
+    __u32 arg2;
+    __u32 count;
+    __u32 color0;
+    __u32 color1;
+    char  text[FT800_MAX_CMD_TEXT_LEN + 1];
+} __packed;
+
+struct ft800_cmd_array {
+    __u32 count;
+    struct ft800_cmd cmd[];  // must follow full struct definition
+} __packed;
+
+/* Keyboard definition struct */
+struct ft800_cmd_keys {
+	__u32 cmd;             /* encoded opcode or CMD_* token            */
+	__u16 x, y;
+	__u16 w, h;
+	__u8  font;
+	__u8  options;
+	const char *text;  // N key labels (one char each)
+       };
+
+/* Bulk command-list (userspace → RAM_CMD) */
+struct ft800_uapi_cmdlist {
+	__u32 addr;        /* must equal FT800_RAM_CMD                    */
+	__u32 len;         /* bytes (multiple of 4)                       */
+	__u32 user_ptr;    /* userspace pointer to contiguous __u32[]     */
+} __packed;
+
+/* Push a pre-mmapped staging buffer to RAM_DL or RAM_G */
+struct ft800_uapi_mmap_push {
+	__u32 addr;        /* FT800_RAM_DL or FT800_RAM_G                 */
+	__u32 len;         /* ≤ size of staging buffer                    */
+} __packed;
+
+/* Soft-reset & optional clear-to-colour */
+struct ft800_uapi_reset {
+	__u8 clear_display; /* 1 = clear before releasing PD_N            */
+	__u8 r, g, b;       /* clear colour                               */
+} __packed;
+
+/* Arbitrary memory I/O helper */
+struct ft800_mem_op {
+	__u32 addr;
+	__u32 len;                    /* driver clamps to sizeof(data)    */
+	__u8  data[4096];
+} __packed;
+
+/* Lightweight status snapshot */
+struct ft800_status {
+	__le16 cmd_read;   /* REG_CMD_READ                                */
+	__le16 cmd_write;  /* REG_CMD_WRITE                               */
+	__u8   id;         /* REG_ID                                      */
+	__u8   pad;
+} __packed;
+
+/* 0x0A ── **NEW**: feed an array of `struct ft800_cmd` descriptors.
+ * `user_ptr` points to the first element, `count` is the number
+ * of descriptors.  The kernel turns them into the byte-stream
+ * with ft800_cmd_enqueue()/ft800_serialize_cmds().
+ */
+struct ft800_uapi_exec_cmds {
+        __u32 user_ptr;   /* (uintptr_t) pointer to first descriptor */
+        __u32 count;      /* number of descriptors                   */
+} __packed;
+
+/* -------------------------------------------------------------------- */
+/*  ioctl interface – must come *after* struct definitions              */
+/* -------------------------------------------------------------------- */
+#define FT800_IOCTL_BASE   'F'
+
+#define FT800_IOCTL_GET_TOUCH    _IOR (FT800_IOCTL_BASE, 0x01, struct ft800_touch)
+#define FT800_IOCTL_SUBMIT_CMDS  _IOW (FT800_IOCTL_BASE, 0x02, struct ft800_uapi_exec_cmds)
+#define FT800_IOCTL_WRITE_CMDS   _IOW (FT800_IOCTL_BASE, 0x03, struct ft800_cmd_array)
+#define FT800_IOCTL_RESET        _IOW (FT800_IOCTL_BASE, 0x04, struct ft800_uapi_reset)
+#define FT800_IOCTL_MEMWRITE     _IOW (FT800_IOCTL_BASE, 0x06, struct ft800_mem_op)
+#define FT800_IOCTL_MEMREAD      _IOWR(FT800_IOCTL_BASE, 0x07, struct ft800_mem_op)
+#define FT800_IOCTL_GET_STATUS   _IOR (FT800_IOCTL_BASE, 0x08, struct ft800_status)
+#define FT800_IOCTL_CLEAR_DL     _IO  (FT800_IOCTL_BASE, 0x09)
+
+
+/* --------------------------------------------------------------------
+ *  Fine-grained register access helpers
+ * ------------------------------------------------------------------*/
+struct ft800_uapi_rw8  { __u32 addr; __u8  value; };
+struct ft800_uapi_rw16 { __u32 addr; __u16 value; };
+
+/* Keep ioctl numbers contiguous, avoid gaps for future proofing */
+#define FT800_IOCTL_WR8    _IOW (FT800_IOCTL_BASE, 0x0B, struct ft800_uapi_rw8)
+#define FT800_IOCTL_RD8    _IOWR(FT800_IOCTL_BASE, 0x0C, struct ft800_uapi_rw8)
+#define FT800_IOCTL_WR16   _IOW (FT800_IOCTL_BASE, 0x0D, struct ft800_uapi_rw16)
+#define FT800_IOCTL_RD16   _IOWR(FT800_IOCTL_BASE, 0x0E, struct ft800_uapi_rw16)
+
+
+
+#endif /* _UAPI_LINUX_FT800_H */
+
